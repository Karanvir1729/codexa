{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "backend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "../apps/**/*.ts",
    "../packages/**/*.ts"
  ]
}
