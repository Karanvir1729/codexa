{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' script.js\"","aggregated_output":"const STORAGE_KEY = \"codexa-smoke-quote-board-two:v1\";\n\nconst seedQuotes = [\n  {\n    id: \"seed-1\",\n    text: \"The best way out is always through.\",\n    author: \"Robert Frost\",\n    favorite: true\n  },\n  {\n    id: \"seed-2\",\n    text: \"What you do every day matters more than what you do once in a while.\",\n    author: \"Gretchen Rubin\",\n    favorite: false\n  },\n  {\n    id: \"seed-3\",\n    text: \"Make it work, make it right, make it fast.\",\n    author: \"Kent Beck\",\n    favorite: false\n  }\n];\n\nconst quoteGrid = document.querySelector(\"#quoteGrid\");\nconst emptyState = document.querySelector(\"#emptyState\");\nconst quoteForm = document.querySelector(\"#quoteForm\");\nconst quoteText = document.querySelector(\"#quoteText\");\nconst quoteAuthor = document.querySelector(\"#quoteAuthor\");\nconst totalCount = document.querySelector(\"#totalCount\");\nconst favoriteCount = document.querySelector(\"#favoriteCount\");\nconst filterButtons = document.querySelectorAll(\".filter-button\");\n\nlet quotes = loadQuotes();\nlet activeFilter = \"all\";\n\nrender();\n\nquoteForm.addEventListener(\"submit\", (event) => {\n  event.preventDefault();\n\n  const text = quoteText.value.trim();\n  const author = quoteAuthor.value.trim() || \"Unknown\";\n\n  if (!text) {\n    quoteText.focus();\n    return;\n  }\n\n  quotes = [\n    {\n      id: createId(),\n      text,\n      author,\n      favorite: false\n    },\n    ...quotes\n  ];\n\n  quoteForm.reset();\n  quoteText.focus();\n  saveQuotes();\n  render();\n});\n\nfilterButtons.forEach((button) => {\n  button.addEventListener(\"click\", () => {\n    activeFilter = button.dataset.filter;\n    render();\n  });\n});\n\nquoteGrid.addEventListener(\"click\", (event) => {\n  const button = event.target.closest(\"button[data-action]\");\n\n  if (!button) {\n    return;\n  }\n\n  const card = button.closest(\"[data-id]\");\n  const id = card.dataset.id;\n  const action = button.dataset.action;\n\n  if (action === \"favorite\") {\n    quotes = quotes.map((quote) => (\n      quote.id === id ? { ...quote, favorite: !quote.favorite } : quote\n    ));\n  }\n\n  if (action === \"delete\") {\n    quotes = quotes.filter((quote) => quote.id !== id);\n  }\n\n  saveQuotes();\n  render();\n});\n\nfunction loadQuotes() {\n  try {\n    const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));\n    return Array.isArray(stored) && stored.length ? stored : seedQuotes;\n  } catch {\n    return seedQuotes;\n  }\n}\n\nfunction saveQuotes() {\n  localStorage.setItem(STORAGE_KEY, JSON.stringify(quotes));\n}\n\nfunction createId() {\n  if (globalThis.crypto && typeof globalThis.crypto.randomUUID === \"function\") {\n    return globalThis.crypto.randomUUID();\n  }\n\n  return `quote-${Date.now()}-${Math.random().toString(16).slice(2)}`;\n}\n\nfunction render() {\n  const visibleQuotes = activeFilter === \"favorites\"\n    ? quotes.filter((quote) => quote.favorite)\n    : quotes;\n\n  totalCount.textContent = quotes.length;\n  favoriteCount.textContent = quotes.filter((quote) => quote.favorite).length;\n  emptyState.hidden = visibleQuotes.length > 0;\n\n  filterButtons.forEach((button) => {\n    button.classList.toggle(\"is-active\", button.dataset.filter === activeFilter);\n  });\n\n  quoteGrid.innerHTML = visibleQuotes.map(createQuoteCard).join(\"\");\n}\n\nfunction createQuoteCard(quote) {\n  const favoriteLabel = quote.favorite ? \"Remove from favorites\" : \"Save to favorites\";\n\n  return `\n    <article class=\"quote-card\" data-id=\"${escapeHtml(quote.id)}\">\n      <p class=\"quote-text\">&ldquo;${escapeHtml(quote.text)}&rdquo;</p>\n      <footer class=\"quote-meta\">\n        <span>${escapeHtml(quote.author)}</span>\n        <span class=\"quote-actions\">\n          <button class=\"icon-button\" type=\"button\" data-action=\"favorite\" aria-label=\"${favoriteLabel}\" aria-pressed=\"${quote.favorite}\">\n            ${quote.favorite ? \"★\" : \"☆\"}\n          </button>\n          <button class=\"icon-button\" type=\"button\" data-action=\"delete\" aria-label=\"Delete quote\">\n            ×\n          </button>\n        </span>\n      </footer>\n    </article>\n  `;\n}\n\nfunction escapeHtml(value) {\n  return String(value)\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"&lt;\")\n    .replaceAll(\">\", \"&gt;\")\n    .replaceAll('\"', \"&quot;\")\n    .replaceAll(\"'\", \"&#039;\");\n}\n","exit_code":0,"status":"completed"}}
