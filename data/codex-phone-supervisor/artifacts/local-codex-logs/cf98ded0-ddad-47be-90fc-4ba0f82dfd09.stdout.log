{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' script.js\"","aggregated_output":"const quotes = [\n  {\n    id: \"craft\",\n    text: \"The details are not the details. They make the design.\",\n    author: \"Charles Eames\",\n    tag: \"Craft\"\n  },\n  {\n    id: \"momentum\",\n    text: \"Great things are done by a series of small things brought together.\",\n    author: \"Vincent van Gogh\",\n    tag: \"Momentum\"\n  },\n  {\n    id: \"clarity\",\n    text: \"Simplicity is prerequisite for reliability.\",\n    author: \"Edsger W. Dijkstra\",\n    tag: \"Clarity\"\n  },\n  {\n    id: \"start\",\n    text: \"The secret of getting ahead is getting started.\",\n    author: \"Mark Twain\",\n    tag: \"Start\"\n  },\n  {\n    id: \"learning\",\n    text: \"Live as if you were to die tomorrow. Learn as if you were to live forever.\",\n    author: \"Mahatma Gandhi\",\n    tag: \"Learning\"\n  },\n  {\n    id: \"focus\",\n    text: \"What you do every day matters more than what you do once in a while.\",\n    author: \"Gretchen Rubin\",\n    tag: \"Focus\"\n  }\n];\n\nconst storageKey = \"codexa-smoke-quote-board-3:favorites\";\nconst quoteGrid = document.querySelector(\"#quoteGrid\");\nconst emptyState = document.querySelector(\"#emptyState\");\nconst favoriteCount = document.querySelector(\"#favoriteCount\");\nconst filterButtons = document.querySelectorAll(\".filter-button\");\n\nlet activeFilter = \"all\";\nlet favoriteIds = loadFavorites();\n\nfunction loadFavorites() {\n  try {\n    const parsed = JSON.parse(localStorage.getItem(storageKey) || \"[]\");\n    return new Set(Array.isArray(parsed) ? parsed : []);\n  } catch {\n    return new Set();\n  }\n}\n\nfunction saveFavorites() {\n  localStorage.setItem(storageKey, JSON.stringify([...favoriteIds]));\n}\n\nfunction renderQuotes() {\n  const visibleQuotes = activeFilter === \"favorites\"\n    ? quotes.filter((quote) => favoriteIds.has(quote.id))\n    : quotes;\n\n  quoteGrid.innerHTML = visibleQuotes.map((quote) => {\n    const isFavorite = favoriteIds.has(quote.id);\n    const star = isFavorite ? \"★\" : \"☆\";\n    const pressed = isFavorite ? \"true\" : \"false\";\n    const buttonLabel = isFavorite ? \"Remove from favorites\" : \"Save to favorites\";\n\n    return `\n      <article class=\"quote-card\">\n        <div>\n          <p class=\"quote-text\">“${quote.text}”</p>\n          <p class=\"quote-author\">— ${quote.author}</p>\n        </div>\n        <div class=\"card-footer\">\n          <span class=\"tag\">${quote.tag}</span>\n          <button class=\"favorite-button ${isFavorite ? \"is-favorite\" : \"\"}\" type=\"button\" data-id=\"${quote.id}\" aria-pressed=\"${pressed}\" aria-label=\"${buttonLabel}: ${quote.author}\">\n            ${star}\n          </button>\n        </div>\n      </article>\n    `;\n  }).join(\"\");\n\n  favoriteCount.textContent = String(favoriteIds.size);\n  emptyState.hidden = !(activeFilter === \"favorites\" && visibleQuotes.length === 0);\n  quoteGrid.hidden = visibleQuotes.length === 0;\n}\n\nfunction setActiveFilter(nextFilter) {\n  activeFilter = nextFilter;\n  filterButtons.forEach((button) => {\n    button.classList.toggle(\"is-active\", button.dataset.filter === activeFilter);\n  });\n  renderQuotes();\n}\n\nquoteGrid.addEventListener(\"click\", (event) => {\n  const favoriteButton = event.target.closest(\".favorite-button\");\n\n  if (!favoriteButton) {\n    return;\n  }\n\n  const quoteId = favoriteButton.dataset.id;\n\n  if (favoriteIds.has(quoteId)) {\n    favoriteIds.delete(quoteId);\n  } else {\n    favoriteIds.add(quoteId);\n  }\n\n  saveFavorites();\n  renderQuotes();\n});\n\nfilterButtons.forEach((button) => {\n  button.addEventListener(\"click\", () => {\n    setActiveFilter(button.dataset.filter);\n  });\n});\n\nrenderQuotes();\n","exit_code":0,"status":"completed"}}
