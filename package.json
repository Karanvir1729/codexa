{
  "name": "tutor-tron-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron desktop/main.cjs",
    "desktop:dev": "electron desktop/main.cjs",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "stt": ".venv-whisperx/bin/python services/whisperx_adapter.py --port 9001",
    "stt:install": "python3.12 -m venv .venv-whisperx && .venv-whisperx/bin/pip install -U pip && .venv-whisperx/bin/pip install -r requirements-whisperx.txt",
    "phone:install": "uv venv .venv-pipecat --python 3.12 && uv pip install --python .venv-pipecat/bin/python -r requirements-pipecat-phone.txt",
    "phone": "node scripts/run-pipecat-phone.mjs",
    "phone:webrtc": ".venv-pipecat/bin/python services/pipecat_twilio_bot.py -t webrtc --host 0.0.0.0 --port 7860",
    "phone:test:codex": "node scripts/test-phone-codex-bridge.mjs",
    "phone:test:stack": "node scripts/test-phone-stack.mjs",
    "phone:test": "npm run phone:test:codex && npm run phone:test:stack",
    "twilio:configure": "node scripts/setup-twilio-voice-webhook.mjs",
    "openclaw:readiness": "node scripts/openclaw-readiness.mjs",
    "openclaw:doctor": "npx openclaw doctor --lint --non-interactive --no-workspace-suggestions --severity-min error",
    "openclaw:gateway": "npx openclaw gateway --dev --bind loopback run",
    "openclaw:control:test": "node scripts/test-openclaw-control.mjs",
    "dev:loop": "node scripts/develop-test-loop.mjs",
    "dev:loop:watch": "node scripts/develop-test-loop.mjs --watch",
    "bench": "node scripts/bench-voice-loop.mjs",
    "test:voice:runner": "node scripts/voice-test-runner.mjs",
    "test:voice:eval": "node scripts/voice-eval-suite.mjs",
    "test:voice:preflight": "node scripts/voice-test-preflight.mjs",
    "test:voice:api": "playwright test tests/voice/api-contract.spec.mjs",
    "test:voice:ui": "playwright test tests/voice/ui-smoke.spec.mjs",
    "test:voice:acoustic": "npm run test:voice:preflight && playwright test tests/voice/acoustic.spec.mjs --headed",
    "test:voice": "playwright test tests/voice"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@openai/codex": "^0.133.0",
    "@playwright/test": "^1.60.0",
    "electron": "^42.2.0",
    "openclaw": "^2026.5.22"
  }
}
