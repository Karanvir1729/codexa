# Supported runtime configuration.
# Copy to .env.local and fill blank secrets locally. Do not commit secrets.

APP_ENV=development
DATABASE_PATH=data/voice_agent.sqlite3
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE=

# LLM: Nemotron 3 Super 120B hosted on AWS for the hackathon path.
LLM_PROVIDER=nemotron
NEMOTRON_LLM_URL=http://nemotron-fleet-alb-1322439314.us-west-2.elb.amazonaws.com/v1
NEMOTRON_LLM_MODEL=nvidia/nemotron-3-super
NEMOTRON_LLM_API_KEY=

REASONING_MODE=on
LLM_TEMPERATURE=0
LLM_TOP_P=0.95
MAX_COMPLETION_TOKENS=180
LLM_TIMEOUT_SECONDS=60
LLM_WARMUP_ENABLED=true
VOICE_LLM_CONTEXT_MESSAGES=8
VOICE_LLM_CONTEXT_MAX_CHARS=700

COST_GUARD_ENABLED=true
COST_GUARD_CAP_USD=95
COST_GUARD_RESERVE_USD_PER_CALL=0.01
COST_GUARD_NEMOTRON_CALL_USD=0.01
COST_GUARD_NEMOTRON_INPUT_PER_1M_TOKENS_USD=0
COST_GUARD_NEMOTRON_OUTPUT_PER_1M_TOKENS_USD=0

# Browser voice runtime: NVIDIA streaming STT + Gradium VAD/TTS only.
VOICE_RUNTIME=local_pipecat
VOICE_BEHAVIOR_MODE=assistant
VOICE_FLOW_ID=active
VOICE_SPEECH_PATH=nvidia_gradium
VOICE_STT_CORRECTION_ENABLED=false
VOICE_EMOTION_CODES_ENABLED=true
VOICE_DEFAULT_PROFILE=balanced
VOICE_MAX_LLM_TTFB_MS=800
VOICE_TARGET_FIRST_AUDIO_MS=1500

LOCAL_VOICE_LANGUAGE=en
LOCAL_STT_LANGUAGE=auto
LOCAL_TTS_LANGUAGE=en
LOCAL_AUDIO_INPUT_SAMPLE_RATE=16000
LOCAL_AUDIO_OUTPUT_SAMPLE_RATE=24000
LOCAL_AUDIO_OUTPUT_10MS_CHUNKS=1
LOCAL_AUDIO_OUTPUT_END_SILENCE_SECS=0
SMALL_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
SMALL_WEBRTC_TURN_URLS=
SMALL_WEBRTC_TURN_USERNAME=
SMALL_WEBRTC_TURN_CREDENTIAL=

LOCAL_STT_PROVIDER=nvidia_ws
LOCAL_STT_MODEL=nemotron-speech-streaming
NVIDIA_ASR_URL=ws://44.241.251.184:8080
NVIDIA_ASR_SAMPLE_RATE=16000
NVIDIA_ASR_PREROLL_SECONDS=1.0
NVIDIA_ASR_STRIP_INTERIM_PREFIX=false
NVIDIA_ASR_WS_PING_INTERVAL=20
NVIDIA_ASR_WS_PING_TIMEOUT=20

LOCAL_TTS_PROVIDER=gradium
LOCAL_TTS_VOICE=YTpq7expH9539ERJ
LOCAL_TTS_TEXT_AGGREGATION_MODE=sentence
GRADIUM_API_KEY=
GRADIUM_VAD_WS_URL=wss://api.gradium.ai/api/speech/asr
GRADIUM_VAD_MODEL=default
GRADIUM_VAD_INPUT_FORMAT=pcm_16000
GRADIUM_VAD_LANGUAGE=en
GRADIUM_VAD_DELAY_IN_FRAMES=8
GRADIUM_VAD_START_INACTIVITY_THRESHOLD=0.35
GRADIUM_VAD_STOP_INACTIVITY_THRESHOLD=0.55
GRADIUM_VAD_START_CONSECUTIVE_STEPS=2
GRADIUM_VAD_STOP_CONSECUTIVE_STEPS=3
GRADIUM_VAD_SAMPLE_RATE=16000
GRADIUM_TTS_WS_URL=wss://api.gradium.ai/api/speech/tts
GRADIUM_TTS_MODEL=default
GRADIUM_TTS_VOICE_ID=YTpq7expH9539ERJ
GRADIUM_TTS_OUTPUT_FORMAT=pcm_24000
GRADIUM_TTS_SPEED=1.0
GRADIUM_TTS_REWRITE_RULES=en
GRADIUM_TTS_TIMEOUT_SECONDS=60

LOCAL_VAD_CONFIDENCE=0.68
LOCAL_VAD_START_SECS=0.05
LOCAL_VAD_STOP_SECS=0.85
LOCAL_VAD_MIN_VOLUME=0.45
LOCAL_VAD_SPEECH_ACTIVITY_PERIOD=0.05
LOCAL_VAD_AUDIO_IDLE_TIMEOUT=1.3
LOCAL_USER_SPEECH_TIMEOUT=0.75
LOCAL_USER_TURN_STOP_TIMEOUT=1.6

CODEX_ORCHESTRATOR_ENABLED=false
CODEX_ORCHESTRATOR_BASE_URL=http://127.0.0.1:4317
CODEX_ORCHESTRATOR_TIMEOUT_SECONDS=60
CODEX_ORCHESTRATOR_TRANSCRIPT_TURNS=12
CODEX_ORCHESTRATOR_TRANSCRIPT_MAX_CHARS=4000

CEKURA_PROJECT_ID=5817
CEKURA_AGENT_ID=18023
CEKURA_API_KEY=
CEKURA_WEBSOCKET_URL=
CEKURA_WEBSOCKET_SECRET=
CEKURA_WEBHOOK_SECRET=
