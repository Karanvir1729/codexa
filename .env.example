# Codex Phone Supervisor
# `.env.codex-phone-supervisor` is also loaded after `.env` for local overrides.
CODEX_PHONE_SUPERVISOR_HOST=127.0.0.1
CODEX_PHONE_SUPERVISOR_PORT=4317
CODEX_PHONE_SUPERVISOR_FRONTEND_PORT=4318
CODEX_PHONE_SUPERVISOR_ALLOWED_ORIGINS=http://127.0.0.1:4318,http://localhost:4318

# Use an explicit Codex executable. Do not rely on PATH lookup.
CODEX_PHONE_SUPERVISOR_CODEX_COMMAND=/absolute/path/to/codex
CODEX_PHONE_SUPERVISOR_CODEX_HOME=/absolute/path/to/.codex
CODEX_PHONE_SUPERVISOR_CODEX_MODEL=gpt-5.5
CODEX_PHONE_SUPERVISOR_CODEX_PROFILE=
CODEX_PHONE_SUPERVISOR_CODEX_PROFILE_V2=
CODEX_PHONE_SUPERVISOR_CODEX_SANDBOX=danger-full-access
CODEX_PHONE_SUPERVISOR_CODEX_BYPASS_APPROVALS_AND_SANDBOX=1
CODEX_PHONE_SUPERVISOR_CODEX_INHERIT_SHELL_ENV=1
CODEX_PHONE_SUPERVISOR_WORKSPACE_PATH=/absolute/path/to/workspace
CODEX_PHONE_SUPERVISOR_NEW_PROJECTS_ROOT=/absolute/path/to/workspace
CODEX_PHONE_SUPERVISOR_PROJECT_ROOTS=/absolute/path/to/projects,/absolute/path/to/other-projects
VITE_SUPERVISOR_WORKSPACE_PATH=/absolute/path/to/workspace

# Local operator terminal. This is direct human shell access, not available to voice/SMS/app chat agents.
CODEX_PHONE_SUPERVISOR_TERMINAL_ENABLED=0
CODEX_PHONE_SUPERVISOR_TERMINAL_SHELL=/absolute/path/to/shell
CODEX_PHONE_SUPERVISOR_TERMINAL_SHELL_ARGS=
CODEX_PHONE_SUPERVISOR_TERMINAL_CWD=/absolute/path/to/workspace
CODEX_PHONE_SUPERVISOR_TERMINAL_PATH=/usr/local/bin:/usr/bin:/bin
CODEX_PHONE_SUPERVISOR_TERMINAL_WS_PATH=/terminal/ws
CODEX_PHONE_SUPERVISOR_TERMINAL_ALLOW_REMOTE=0

# Physical desktop terminal launcher for the local human operator. Keep disabled on servers.
CODEX_PHONE_SUPERVISOR_DESKTOP_TERMINAL_ENABLED=0
CODEX_PHONE_SUPERVISOR_OSASCRIPT_COMMAND=/absolute/path/to/osascript
CODEX_PHONE_SUPERVISOR_DESKTOP_TERMINAL_APP_ID=com.apple.Terminal
CODEX_PHONE_SUPERVISOR_DESKTOP_TERMINAL_PATH=/usr/local/bin:/usr/bin:/bin
CODEX_PHONE_SUPERVISOR_DESKTOP_TERMINAL_LAUNCH_TIMEOUT_MS=5000

# Local persistence. Runtime data is ignored by git.
CODEX_PHONE_SUPERVISOR_STORE_DIR=data/codex-phone-supervisor
CODEX_PHONE_SUPERVISOR_FRONTEND_DIST_DIR=codex-phone-supervisor/frontend/dist
CODEX_PHONE_SUPERVISOR_LOCK_TIMEOUT_MS=5000
CODEX_PHONE_SUPERVISOR_LOCK_RETRY_MS=25
CODEX_PHONE_SUPERVISOR_TEST_MODE=0

# User-facing supervisor/planner mode. Runtime defaults to local Codex CLI; mock is not a valid runtime provider.
SUPERVISOR_MODEL_PROVIDER=codex_cli
GCP_CONVERSATION_PROJECT_ID=
GCP_CONVERSATION_LOCATION=
GCP_CONVERSATION_AGENT_ID=
GCP_CONVERSATION_LANGUAGE_CODE=en-US
GCP_CONVERSATION_API_ENDPOINT=
GCP_CONVERSATION_ENVIRONMENT_ID=
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_ALLOW_INSECURE_HTTP=0
OPENAI_MODEL=
OPENAI_API_KEY=

# GCP VM Codex auth. Use a dedicated ChatGPT-login Codex home bundle for worker VMs.
# Create it with scripts/gcp/create-codex-vm-home-bundle.sh. API-key auth is fallback-only and not the default smoke path.
HEAD_DEVELOPER_CODEX_AUTH_METHOD=codex_home_bundle
HEAD_DEVELOPER_CODEX_HOME=/codex-home
HEAD_DEVELOPER_CODEX_HOME_BUNDLE_SECRET=codex-vm-home-bundle
HEAD_DEVELOPER_CODEX_HOME_BUNDLE_SECRET_PROJECT=
HEAD_DEVELOPER_CODEX_HOME_BUNDLE_SECRET_VERSION=latest
HEAD_DEVELOPER_CODEX_HOME_BUNDLE_GCS_URI=
HEAD_DEVELOPER_CODEX_API_KEY_SECRET=
HEAD_DEVELOPER_CODEX_API_KEY_SECRET_PROJECT=
HEAD_DEVELOPER_CODEX_API_KEY_SECRET_VERSION=latest

# Remote worker backends.
WORKER_MODE=codex_session_local
DEFAULT_WORKER_MODE=codex_session_local
MAX_GKE_JOB_WORKERS=5
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
HEAD_DEVELOPER_API_CALLBACK_URL=
HEAD_DEVELOPER_WORKER_IMAGE_URI=REGION-docker.pkg.dev/PROJECT/head-developer/worker:TAG
HEAD_DEVELOPER_GKE_CLUSTER_NAME=head-developer-workers
HEAD_DEVELOPER_GKE_LOCATION=us-central1
HEAD_DEVELOPER_GKE_NAMESPACE=head-developer-workers
HEAD_DEVELOPER_GKE_KSA=head-developer-worker
HEAD_DEVELOPER_GKE_GSA=gke-worker-sa@PROJECT.iam.gserviceaccount.com
HEAD_DEVELOPER_GKE_JOB_TTL_SECONDS=900
HEAD_DEVELOPER_GKE_JOB_ACTIVE_DEADLINE_SECONDS=3600

# App clients and local simulators.
CODEX_PHONE_SUPERVISOR_API_BASE=http://127.0.0.1:4317
VITE_SUPERVISOR_API_BASE=http://127.0.0.1:4317
VITE_SUPERVISOR_USER_ID=local-operator
CODEX_PHONE_SUPERVISOR_SIM_USER_ID=local-operator

# Twilio phone/SMS integration. Signature validation requires both values.
TWILIO_SMS_ENABLED=0
TWILIO_VOICE_ENABLED=0
CODEX_PHONE_SUPERVISOR_PUBLIC_BASE_URL=
TWILIO_CONVERSATION_RELAY_WS_URL=
TWILIO_VALIDATE_SIGNATURES=0
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
