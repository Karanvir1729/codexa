# Core runtime
APP_ENV=development
DATABASE_PATH=data/voice_agent.sqlite3
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider: mock | ollama | nvidia | vertex_nim | local
LLM_PROVIDER=mock

# NVIDIA NIM / build.nvidia.com OpenAI-compatible API
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-nemotron

# NVIDIA NIM deployed behind Vertex AI rawPredict. This still uses GCP GPU
# quota, but gives managed endpoint operations once the model is deployed.
VERTEX_NIM_PROJECT=
VERTEX_NIM_REGION=us-east4
VERTEX_NIM_ENDPOINT_ID=
VERTEX_NIM_ENDPOINT_URL=
VERTEX_NIM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1

# Local Ollama. qwen2.5:0.5b is the default real local LLM for fast voice tests.
# Swap LLM_PROVIDER/OLLAMA_MODEL to an external fast model for higher production quality.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=30m

# Self-hosted vLLM on AWS, GCP, or a local GPU. Keep the app on this
# OpenAI-compatible contract so cloud providers can be swapped by URL.
LOCAL_LLM_BASE_URL=http://localhost:5000/v1
LOCAL_LLM_API_KEY=dummy
LOCAL_LLM_MODEL=Llama-3_3-Nemotron-Super-49B-v1_5

# GCP deployment helper defaults. These are consumed by scripts/gcp_*.sh,
# not by the FastAPI runtime directly.
GCP_PROJECT_ID=
GCP_ZONE=northamerica-northeast1-b
GCP_REGION=northamerica-northeast1
GCP_VLLM_INSTANCE_NAME=voice-agent-vllm
GCP_VLLM_MACHINE_TYPE=g2-standard-12
GCP_VOXTRAL_TTS_INSTANCE_NAME=voice-agent-voxtral-tts
GCP_VOXTRAL_TTS_MACHINE_TYPE=g2-standard-12
GCP_APP_INSTANCE_NAME=voice-agent-app
GCP_APP_MACHINE_TYPE=e2-standard-4
GCP_BILLING_ACK=false
ALLOWED_CIDR=
AUTO_STOP_HOURS=4
VLLM_VERSION=0.10.2

# Reasoning defaults for Llama/Nemotron style models
REASONING_MODE=on
LLM_TEMPERATURE=0
LLM_TOP_P=0.95
MAX_COMPLETION_TOKENS=24
LLM_TIMEOUT_SECONDS=60
LLM_WARMUP_ENABLED=true
VOICE_LLM_CONTEXT_MESSAGES=8
VOICE_LLM_CONTEXT_MAX_CHARS=700

# Local estimated spend guard. This is an app-level cap, not an AWS billing guarantee.
COST_GUARD_ENABLED=true
COST_GUARD_CAP_USD=95
COST_GUARD_RESERVE_USD_PER_CALL=0.01
COST_GUARD_MOCK_CALL_USD=0
COST_GUARD_LOCAL_CALL_USD=0
COST_GUARD_NVIDIA_CALL_USD=0.01
COST_GUARD_NVIDIA_INPUT_PER_1M_TOKENS_USD=0
COST_GUARD_NVIDIA_OUTPUT_PER_1M_TOKENS_USD=0

# Twilio telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=false

# Pipecat Cloud shortcut. When set, /twilio/inbound returns TwiML that
# connects Twilio directly to Pipecat Cloud's regional WebSocket endpoint.
PIPECAT_CLOUD_WS_URL=
PIPECAT_CLOUD_SERVICE_HOST=

# Voice runtime:
# - text: web/API text loop only.
# - local_pipecat: local Mac microphone/speaker through open-source Pipecat STT/TTS.
# - pipecat: Twilio media-stream runtime using provider STT/TTS keys.
VOICE_RUNTIME=text

# Local/cloud Pipecat voice runtime. For GCP VM deployments, the target
# self-hosted path is remote Faster Whisper STT + Voxtral/Fish/Piper TTS.
# Keep provider contracts URL-based so we can move between GCP and AWS later.
LOCAL_VOICE_LANGUAGE=en
LOCAL_STT_LANGUAGE=auto
LOCAL_TTS_LANGUAGE=en
# LOCAL_AUDIO_INPUT_DEVICE_INDEX=0
# LOCAL_AUDIO_OUTPUT_DEVICE_INDEX=0
LOCAL_AUDIO_INPUT_SAMPLE_RATE=16000
LOCAL_AUDIO_OUTPUT_SAMPLE_RATE=24000
LOCAL_AUDIO_OUTPUT_10MS_CHUNKS=1
LOCAL_AUDIO_OUTPUT_END_SILENCE_SECS=0
SMALL_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
LOCAL_STT_PROVIDER=remote_whisper
LOCAL_STT_MODEL=large-v3-turbo
LOCAL_STT_NO_SPEECH_PROB=0.25
LOCAL_STT_TEMPERATURE=0
LOCAL_STT_TTFB_TIMEOUT=0.6
LOCAL_STT_TTFS_P99_LATENCY=0.8
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=auto
REMOTE_WHISPER_BASE_URL=http://127.0.0.1:7001
REMOTE_WHISPER_TIMEOUT_SECONDS=8
REMOTE_WHISPER_BEAM_SIZE=3
REMOTE_WHISPER_BEST_OF=3
REMOTE_WHISPER_PATIENCE=1.0
REMOTE_WHISPER_REPETITION_PENALTY=1.05
REMOTE_WHISPER_NO_REPEAT_NGRAM_SIZE=3
REMOTE_WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
REMOTE_WHISPER_MULTILINGUAL=true
REMOTE_WHISPER_VAD_FILTER=false
REMOTE_WHISPER_LANGUAGE_DETECTION_THRESHOLD=0.35
REMOTE_WHISPER_LANGUAGE_DETECTION_SEGMENTS=2
REMOTE_WHISPER_INITIAL_PROMPT=This is a live voice agent conversation. Transcribe English, Hindi, Urdu, and Hinglish accurately. Preserve technical terms and names such as Pipecat, PipeCAD, Cekura, NVIDIA NIM, Nemotron, Mistral, Voxtral, Twilio, WebRTC, Vercel, Cloudflare, Google Cloud, Vertex AI, Whisper, STT, and TTS.
REMOTE_WHISPER_HOTWORDS=Pipecat, PipeCAD, Cekura, Daily, NVIDIA, NIM, Nemotron, Mistral, Voxtral, Whisper, Faster Whisper, Twilio, WebRTC, Vercel, Cloudflare, Google Cloud, GCP, Vertex AI, GPU, TPU, LLM, STT, TTS, Hindi, Urdu, Hinglish
REMOTE_WHISPER_MIN_RMS=0.003
REMOTE_WHISPER_MIN_DURATION_S=0.10
REMOTE_WHISPER_MIN_LANGUAGE_PROB=0.18
REMOTE_WHISPER_MIN_AVG_LOGPROB=-1.1
REMOTE_WHISPER_MAX_COMPRESSION_RATIO=2.6
REMOTE_WHISPER_HALLUCINATION_MAX_DURATION_S=1.6
REMOTE_WHISPER_HALLUCINATION_MAX_RMS=0.018
REMOTE_WHISPER_ADAPTIVE_NOISE_FLOOR=true
REMOTE_WHISPER_NOISE_FLOOR_ALPHA=0.08
REMOTE_WHISPER_NOISE_FLOOR_MULTIPLIER=1.8
REMOTE_WHISPER_MAX_ADAPTIVE_MIN_RMS=0.03
LOCAL_WHISPERX_DEVICE=auto
LOCAL_WHISPERX_COMPUTE_TYPE=auto
LOCAL_WHISPERX_BATCH_SIZE=1
LOCAL_TTS_PROVIDER=piper
LOCAL_TTS_TEXT_AGGREGATION_MODE=sentence
# Kokoro examples: af_heart, af_bella, am_adam
# Piper examples: en_US-lessac-medium, en_US-ryan-high
LOCAL_TTS_VOICE=af_heart
PIPER_DOWNLOAD_DIR=/app/data/piper
NVIDIA_STT_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_STT_USE_SSL=true
NVIDIA_TTS_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_USE_SSL=true
LOCAL_GOOGLE_CREDENTIALS=
LOCAL_GOOGLE_CREDENTIALS_PATH=
LOCAL_GOOGLE_STT_LOCATION=global
LOCAL_GOOGLE_TTS_LOCATION=
FISH_SPEECH_BASE_URL=http://127.0.0.1:8080
FISH_SPEECH_API_KEY=
FISH_SPEECH_REFERENCE_ID=
FISH_SPEECH_LATENCY=normal
FISH_SPEECH_CHUNK_LENGTH=300
FISH_SPEECH_MAX_NEW_TOKENS=1024
FISH_SPEECH_TOP_P=0.8
FISH_SPEECH_REPETITION_PENALTY=1.1
FISH_SPEECH_TEMPERATURE=0.8
FISH_SPEECH_TIMEOUT_SECONDS=120

# Voxtral TTS via vLLM-Omni. Set LOCAL_TTS_PROVIDER=voxtral after the
# dedicated TTS VM is healthy, then point this URL at the internal VM IP.
VOXTRAL_TTS_BASE_URL=http://127.0.0.1:8002/v1
VOXTRAL_TTS_API_KEY=
VOXTRAL_TTS_MODEL=mistralai/Voxtral-4B-TTS-2603
VOXTRAL_TTS_VOICE=neutral_female
VOXTRAL_TTS_VOICE_ID=
VOXTRAL_TTS_LANGUAGE=Auto
VOXTRAL_TTS_INSTRUCTIONS=Speak naturally, warmly, and quickly. Match the user's language when possible. Keep emotional tone calm and helpful unless the text clearly asks for a different tone.
VOXTRAL_TTS_REF_AUDIO_PATH=
VOXTRAL_TTS_RESPONSE_FORMAT=pcm
VOXTRAL_TTS_STREAM=true
VOXTRAL_TTS_PCM_ENCODING=int16
# Lower this experimentally after baseline latency traces; vLLM-Omni uses it
# to tune first-audio chunking.
VOXTRAL_TTS_INITIAL_CODEC_CHUNK_FRAMES=
VOXTRAL_TTS_TIMEOUT_SECONDS=120

LOCAL_VAD_CONFIDENCE=0.68
LOCAL_VAD_START_SECS=0.05
LOCAL_VAD_STOP_SECS=0.12
LOCAL_VAD_MIN_VOLUME=0.36
LOCAL_VAD_SPEECH_ACTIVITY_PERIOD=0.05
LOCAL_VAD_AUDIO_IDLE_TIMEOUT=0.35
LOCAL_USER_SPEECH_TIMEOUT=0.16
LOCAL_USER_TURN_STOP_TIMEOUT=0.3

# Provider-key Pipecat services. Required only for Twilio VOICE_RUNTIME=pipecat.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# Auto-improvement harness. Set EVAL_SCHEDULE_SECONDS > 0 to run evals repeatedly.
LATENCY_TARGET_MS=1200
EVAL_SUITE_PATH=backend/evals/customer_intake.yml
EVAL_SCHEDULE_SECONDS=0
EVAL_SCHEDULE_APPLY_FEEDBACK=true
