VOICE_AGENT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=320

STT_PROVIDER=whisperx
WHISPERX_URL=http://127.0.0.1:9001
WHISPERX_MODEL=base
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
SPEAKER_GUARD_URL=http://127.0.0.1:9001
SPEAKER_TARGET_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1
SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
SPEAKER_PROFILE_STORE=data/speaker_profiles.json
SPEAKER_USER_THRESHOLD=0.58
SPEECH_FLOW_URL=http://127.0.0.1:9001
SPEECH_FLOW_TIMEOUT_MS=2500
SPEECH_INTENT_MODE=rewrite
SPEECH_INTENT_TIMEOUT_MS=60000
SPEECH_INTENT_NUM_PREDICT=220

TTS_PROVIDER=fish
FISH_API_KEY=
FISH_TTS_MODEL=s2-pro
FISH_LATENCY=balanced
FISH_REFERENCE_ID=

AGENT_SYSTEM_PROMPT=You are Tutor-Tron, a realtime conversational voice tutor. Respond naturally and concisely to any user prompt. If interrupted, adapt immediately to the latest user words.

TELEPHONY_STACK=pipecat
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PHONE_NUMBER_SID=
TWILIO_WEBHOOK_BASE_URL=
PIPECAT_TRANSPORT=twilio
PIPECAT_PUBLIC_WS_URL=
DAILY_API_KEY=
