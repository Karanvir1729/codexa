#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";
import {
  apiGet,
  apiPost,
  assertSmoke,
  defaultApiBase,
  fetchText,
  log,
  printJsonSummary,
  readLatestResult,
  smokeStateDir,
  stripHtml,
  waitForApi,
  writeLatestResult,
} from "./lib.mjs";

const smokeName = "preview-smoke";
const apiBase = defaultApiBase;

await waitForApi(apiBase);

const sessionIds = await candidateSessionIds();
assertSmoke(sessionIds.length > 0, "No candidate sessions found. Run docker-single-worker-app-smoke first or set SMOKE_SESSION_ID.");

let previewPayload = null;
let previewError = "";
let selectedSessionId = null;
for (const sessionId of sessionIds) {
  try {
    previewPayload = await apiPost(apiBase, `/sessions/${encodeURIComponent(sessionId)}/preview`, {});
    selectedSessionId = sessionId;
    break;
  } catch (error) {
    previewError = error instanceof Error ? error.message : String(error);
  }
}
assertSmoke(previewPayload?.preview, `No previewable completed app was found. Last error: ${previewError}`);

const preview = previewPayload.preview;
const browserResult = await inspectWithPlaywright(preview).catch((error) => {
  log(`Playwright preview inspection unavailable: ${error instanceof Error ? error.message : String(error)}`);
  return null;
});

let textLength = browserResult?.textLength ?? 0;
let screenshotPath = browserResult?.screenshotPath ?? null;
let consoleErrors = browserResult?.consoleErrors ?? preview.console_errors ?? [];

if (!browserResult) {
  const html = await fetchText(preview.preview_url);
  textLength = stripHtml(html).length;
  consoleErrors = preview.console_errors ?? [];
}

assertSmoke(textLength > 0, `Preview ${preview.preview_id} is blank.`);
assertSmoke(consoleErrors.length === 0, `Preview ${preview.preview_id} has console errors: ${consoleErrors.join(" | ")}`);

if (browserResult) {
  await apiPost(apiBase, `/previews/${encodeURIComponent(preview.preview_id)}/report`, {
    loaded: true,
    console_errors: consoleErrors,
    screenshot_path: screenshotPath,
  });
}

const output = {
  smoke: smokeName,
  session_id: selectedSessionId,
  project_id: preview.project_id,
  task_id: preview.task_id,
  worker_id: preview.worker_id,
  preview_id: preview.preview_id,
  preview_url: preview.preview_url,
  page_text_length: textLength,
  console_errors: consoleErrors,
  screenshot_path: screenshotPath,
};
writeLatestResult(smokeName, output);
printJsonSummary("preview-smoke passed", output);

async function candidateSessionIds() {
  if (process.env.SMOKE_SESSION_ID) return [process.env.SMOKE_SESSION_ID.trim()];
  const latest = readLatestResult("latest-app-smoke");
  const ids = latest?.session_id ? [latest.session_id] : [];
  try {
    const payload = await apiGet(apiBase, "/codex/status");
    for (const session of payload.sessions ?? []) ids.push(session.session_id);
  } catch {
    // The latest smoke result is enough when the session list endpoint is unavailable.
  }
  return [...new Set(ids.filter(Boolean))];
}

async function inspectWithPlaywright(preview) {
  let chromium;
  try {
    ({ chromium } = await import("playwright"));
  } catch {
    throw new Error("playwright package is not installed");
  }
  fs.mkdirSync(path.join(smokeStateDir, "screenshots"), { recursive: true });
  const screenshotPath = path.join(smokeStateDir, "screenshots", `${preview.preview_id}.png`);
  const browser = await chromium.launch({ headless: true });
  try {
    const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
    const consoleErrors = [];
    page.on("console", (message) => {
      if (message.type() === "error") consoleErrors.push(message.text());
    });
    page.on("pageerror", (error) => {
      consoleErrors.push(error.message);
    });
    const response = await page.goto(preview.preview_url, { waitUntil: "networkidle", timeout: 30_000 });
    assertSmoke(response?.ok(), `Preview browser navigation returned HTTP ${response?.status() ?? "unknown"}.`);
    const text = await page.locator("body").innerText({ timeout: 5000 }).catch(() => "");
    await page.screenshot({ path: screenshotPath, fullPage: true });
    return {
      textLength: text.replace(/\s+/g, " ").trim().length,
      consoleErrors,
      screenshotPath,
    };
  } finally {
    await browser.close();
  }
}
