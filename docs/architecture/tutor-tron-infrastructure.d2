direction: right

title: "Tutor-Tron Deployment, Redundancy + Caching"

ingress: "Ingress" {
  direction: down
  traefik: "Traefik\nTLS + routing"
  daily: "Daily / WebRTC\nmedia ingress"
}

swarm: "Docker Swarm" {
  direction: down
  voice_gateway: "voice-gateway\n2 replicas"
  orchestrator: "tutor-orchestrator\n3 replicas"
  agents: "agent-workers\n2+ replicas each"
  api: "dashboard-api\n2 replicas"
}

stateful: "Stateful Core" {
  direction: down
  redis: "Redis\nstreams + cache"
  postgres: "Postgres\nsessions + versions"
  qdrant: "Qdrant\nRAG indexes"
  minio: "S3 / MinIO\nraw artifacts"
}

caching: "Cache Strategy" {
  direction: down
  l1: "L1\nper-session memory"
  redis_cache: "L2 Redis\nRAG, embeddings, strategy scores"
  tts_cache: "TTS Phrase Cache"
  eval_cache: "Eval Cache\ncase x version"
}

ci: "Release Safety" {
  direction: down
  tests: "Scenario Suite"
  replay: "Production Replay"
  load: "Voice Load Test"
  gate: "Release Gate\nblock regressions"
}

obs: "Observability" {
  direction: down
  otel: "OpenTelemetry"
  prometheus: "Prometheus"
  grafana: "Grafana"
  alerts: "Ops Alerts"
}

ingress.traefik -> swarm.voice_gateway: "route voice API"
ingress.daily -> swarm.voice_gateway: "media session"
ingress.traefik -> swarm.api: "route dashboard"

swarm.voice_gateway -> swarm.orchestrator: "transcripts"
swarm.orchestrator -> swarm.agents: "events"
swarm.orchestrator -> caching.l1: "hot state"
caching.l1 -> caching.redis_cache: "miss"
caching.redis_cache -> stateful.redis: "shared cache"
swarm.agents -> stateful.redis: "streams"
swarm.agents -> stateful.qdrant: "retrieval"
swarm.agents -> stateful.postgres: "state + versions"
swarm.agents -> stateful.minio: "traces + audio"

ci.tests -> ci.replay: "known failures"
ci.replay -> ci.load: "stress candidate"
ci.load -> ci.gate: "pass/fail"
ci.gate -> swarm.orchestrator: "deploy candidate"

swarm.voice_gateway -> obs.otel: "voice traces"
swarm.orchestrator -> obs.otel: "decision traces"
swarm.agents -> obs.prometheus: "worker metrics"
obs.otel -> obs.prometheus: "trace metrics"
obs.prometheus -> obs.grafana: "dashboards"
obs.prometheus -> obs.alerts: "thresholds"
