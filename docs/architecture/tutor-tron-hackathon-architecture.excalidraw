      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hybrid-cloud rule: realtime voice path stays colocated.\nAsync eval/replay workers can run cross-cloud because they do not block live tutoring.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Hybrid-cloud rule: realtime voice path stays colocated.\nAsync eval/replay workers can run cross-cloud because they do not block live tutoring.",
      "lineHeight": 1.15,
      "baseline": 10
    },
    {
      "id": "text_0226",
      "type": "text",
      "x": 1090,
      "y": 1700,
      "width": 720,
      "height": 33,
      "angle": 0,
