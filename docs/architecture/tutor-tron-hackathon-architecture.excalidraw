      "version": 1,
      "versionNonce": 800226,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Legend: red solid = synchronous realtime | blue dashed = async events\ngreen = eval-gated promotion | gray dotted = fallback/rollback",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Legend: red solid = synchronous realtime | blue dashed = async events\ngreen = eval-gated promotion | gray dotted = fallback/rollback",
      "lineHeight": 1.15,
      "baseline": 10
    },
