      "versionNonce": 800227,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Daily = realtime voice | Cekura = eval/monitor/replay | NVIDIA = model runtime | GCP now -> AWS later",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
