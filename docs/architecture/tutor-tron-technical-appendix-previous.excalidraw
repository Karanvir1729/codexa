      "versionNonce": 900168,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Simulation, replay, regression testing, monitoring, and gated promotion. The tutor improves by promoting tested strategy versions, not by live fine-tuning.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Simulation, replay, regression testing, monitoring, and gated promotion. The tutor improves by promoting tested strategy versions, not by live fine-tuning.",
