      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hybrid-cloud note: GCP prototype for speed; AWS target for production. Realtime voice stays colocated.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Hybrid-cloud note: GCP prototype for speed; AWS target for production. Realtime voice stays colocated.",
      "lineHeight": 1.15,
      "baseline": 12
    },
    {
      "id": "text_0252",
      "type": "text",
      "x": 70,
      "y": 1928,
      "width": 1050,
      "height": 18,
      "angle": 0,
