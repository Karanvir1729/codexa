      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Legend: red = realtime | blue dashed = async event/data | green = eval-gated promotion | gray dotted = fallback/rollback",
