      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Do not split live voice across clouds.\nKeep WebRTC/Twilio, Pipecat, ASR, LLM, and TTS colocated.",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Do not split live voice across clouds.\nKeep WebRTC/Twilio, Pipecat, ASR, LLM, and TTS colocated.",
      "lineHeight": 1.15,
      "baseline": 7
    },
