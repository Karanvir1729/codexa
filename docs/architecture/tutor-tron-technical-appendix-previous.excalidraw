      "text": "4. CEKURA-STYLE SELF-IMPROVEMENT LOOP: Failure -> Promoted Teaching Strategy",
      "fontSize": 27,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
