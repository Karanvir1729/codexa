      "originalText": "4. CEKURA-STYLE SELF-IMPROVEMENT LOOP: Failure -> Promoted Teaching Strategy",
      "lineHeight": 1.15,
      "baseline": 20
    },
    {
      "id": "text_0168",
      "type": "text",
      "x": 69,
      "y": 1240,
      "width": 1832,
      "height": 18,
      "angle": 0,
      "strokeColor": "#16a34a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
