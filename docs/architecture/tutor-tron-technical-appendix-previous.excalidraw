      "versionNonce": 900252,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Async eval/replay workers can move clouds because they do not block live tutoring.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Async eval/replay workers can move clouds because they do not block live tutoring.",
      "lineHeight": 1.15,
      "baseline": 11
    },
